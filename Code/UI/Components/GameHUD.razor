@using Sandbox
@using Sandbox.UI
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@inherits PanelComponent
@namespace Sandbox

<root class="game-hud">
	@if (GameState?.State == GameStateType.WaitingForPlayers)
	{
		<div class="lobby-layout">
			<div class="logo-container">
				<img src="/art/asset/icons/logo.png" class="game-logo" alt="Devil Pact" />
			</div>

			<div class="ready-status-container">
				<div class="ready-status-text">Waiting for all players ready</div>
				<div class="ready-status-count">@ReadyCountText</div>
			</div>

			<div class="lobby-bottom-bar">
				<div class="phase-text lobby-instructions" @ref="PhaseTextPanel">
					@PhaseText
				</div>

				<div class="player-count" @ref="PlayerCountPanel">
					@PlayerCountText
				</div>
			</div>

			<div class="ladder-panel">
				<div class="ladder-title">GLOBAL LADDER</div>
				<div class="ladder-subtitle">@LadderSubtitle</div>

				<div class="ladder-row ladder-header">
					<span class="ladder-rank">#</span>
					<span class="ladder-name">PLAYER</span>
					<span class="ladder-round">ROUND</span>
					<span class="ladder-time">TIME</span>
				</div>

				<div class="ladder-list">
					@if (_ladder is { } ladder && ladder.Top.Count > 0)
					{
						foreach (var row in ladder.Top)
						{
							<div class="ladder-row @(row.IsMe ? "me" : "") @(row.Rank <= 3 ? "podium" : "")">
								<span class="ladder-rank">@row.Rank</span>
								<span class="ladder-name">@row.Name</span>
								<span class="ladder-round">@row.Rounds</span>
								<span class="ladder-time">@RunLeaderboard.FormatTime(row.Seconds)</span>
							</div>
						}
					}
					else
					{
						<div class="ladder-empty">@LadderEmptyText</div>
					}
				</div>

				@if (MyRowOutsideTop is { } myRow)
				{
					<div class="ladder-row me pinned">
						<span class="ladder-rank">@myRow.Rank</span>
						<span class="ladder-name">@myRow.Name</span>
						<span class="ladder-round">@myRow.Rounds</span>
						<span class="ladder-time">@RunLeaderboard.FormatTime(myRow.Seconds)</span>
					</div>
				}
			</div>
		</div>
	}
	else if (GameState?.State == GameStateType.Starting)
	{
		<div class="starting-container">
			<div class="playing-timer">@TimerText</div>
			<div class="starting-subtitle">The round is starting</div>
		</div>
	}
	else if (GameState?.State == GameStateType.Playing)
	{
		<div class="round-corner-panel">
			<div class="round-badge-content">
				<span class="round-badge-label">ROUND</span>
				<span class="round-badge-number">@CurrentRoundText</span>
			</div>
		</div>

		<div class="playing-container">
			<div class="playing-timer">@TimerText</div>
			<div class="playing-enemy-count">@EnemyCountText</div>
		</div>

		@if (IsLocalPlayerDown)
		{
			<div class="ghost-banner">
				<div class="ghost-title">@(IsLocalPlayerOut ? "YOU ARE GONE" : "YOU ARE A GHOST")</div>
				<div class="ghost-subtitle">@GhostSubtitle</div>
			</div>
		}
	}
	else if (GameState?.State == GameStateType.WaitingForNextRound)
	{
		@if (ShowRoundWonBanner)
		{
			<div class="round-won-container">
				<div class="round-won-text @(IsRoundEndBad ? "lost" : "")">@RoundEndText</div>
			</div>
		}
		else if (AreAllPlayersReady() && (GameState?.PhaseTimer ?? 0f) > 0f)
		{
			<div class="starting-container">
				<div class="playing-timer">@TimerText</div>
				<div class="starting-subtitle">Next round will start</div>
			</div>
		}
		else if (IsLocalPlayerOut)
		{
			<div class="waiting-rewards-container">
				<div class="waiting-rewards-card eliminated-card">
					<div class="waiting-rewards-title">YOU ARE GONE</div>
					<div class="waiting-rewards-subtitle">No life left to trade. Haunt the arena while your team keeps going...</div>
					<div class="waiting-spinner"></div>
				</div>
			</div>
		}
		else if (ShowWaitingForPlayersBanner)
		{
			<div class="waiting-rewards-container">
				<div class="waiting-rewards-card">
					<div class="waiting-rewards-title">WAITING FOR OTHER PLAYERS</div>
					<div class="waiting-rewards-subtitle">The next round will start once everyone claims their power...</div>
					<div class="waiting-spinner"></div>
				</div>
			</div>
		}
		else if (MustDevilPact && !_pactCompleted)
		{
			<div class="devil-pact-hud forced @(_isFadingOutPact ? "fade-out" : "")">
				<div class="pact-container">
					<div class="pact-side dark-side forced-side">
						<div class="pact-hover-glow"></div>
						<div class="pact-content">
							<div class="pact-forced-tag">YOU FELL THIS ROUND</div>
							<div class="pact-title">DEVIL PACT</div>
							<div class="pact-description">Death already took its life and half of your levels. The shadows are the only way back.</div>

							<div class="pact-trade-details">
								<div class="trade-item cost">
									<span class="trade-value">@LivesLeft</span>
									<span class="trade-label">@(LivesLeft > 1 ? "LIVES LEFT" : "LIFE LEFT")</span>
								</div>
								<div class="trade-divider">➔</div>
								<div class="trade-item gain">
									<span class="trade-prefix">+</span>
									<span class="trade-value">@BonusCount</span>
									<span class="trade-label">@(BonusCount > 1 ? "BONUSES" : "BONUS")</span>
								</div>
							</div>

							<button class="pact-button dark-button" onclick="@OnDarkChosen">MAKE A PACT</button>
						</div>
					</div>
				</div>
			</div>
		}
		else if (!_pactCompleted)
		{
			<div class="devil-pact-hud @(_isFadingOutPact ? "fade-out" : "")">
				<div class="pact-container">
					<div class="pact-side light-side">
						<div class="pact-hover-glow"></div>
						<div class="pact-content">
							<div class="pact-title">ONE MORE ROUND</div>
							<div class="pact-description">Embrace the light. Continue the fight with your current strength.</div>
							<button class="pact-button light-button" onclick="@OnLightChosen">ACCEPT</button>
						</div>
					</div>

					<div class="pact-side dark-side">
						<div class="pact-hover-glow"></div>
						<div class="pact-content">
							<div class="pact-title">DEVIL PACT</div>
							<div class="pact-description">Yield to the shadows. Trade your essence for forbidden power.</div>

							<div class="pact-trade-details">
								<div class="trade-item cost">
									<span class="trade-prefix">-</span>
									<span class="trade-value">1</span>
									<span class="trade-label">LIFE</span>
								</div>
								<div class="trade-divider">➔</div>
								<div class="trade-item gain">
									<span class="trade-prefix">+</span>
									<span class="trade-value">@BonusCount</span>
									<span class="trade-label">@(BonusCount > 1 ? "BONUSES" : "BONUS")</span>
								</div>
							</div>

							@if (CanAffordPact)
							{
								<button class="pact-button dark-button" onclick="@OnDarkChosen">MAKE A PACT</button>
							}
							else
							{
								<button class="pact-button dark-button disabled">LAST LIFE, NO PACT</button>
							}
						</div>
					</div>
				</div>
			</div>
		}
	}
	else if (GameState?.State == GameStateType.GameOver)
	{
		<div class="game-over-container">
			<div class="game-over-card">
				<div class="game-over-title">GAME OVER</div>
				<div class="game-over-subtitle">The devil collected every soul.</div>

				<div class="game-over-stat">
					<span class="game-over-stat-value">@CurrentRoundText</span>
					<span class="game-over-stat-label">@(GameState.CurrentRound > 1 ? "ROUNDS SURVIVED" : "ROUND SURVIVED")</span>
					<span class="game-over-stat-time">IN @RunTimeText</span>
				</div>

				@if (LocalPlayer != null)
				{
					<div class="run-stats">
						<div class="run-stats-title">YOUR RUN</div>

						<div class="run-stats-grid">
							@foreach (var stat in RunStats)
							{
								<div class="run-stat">
									<span class="run-stat-value">@stat.Value</span>
									<span class="run-stat-label">@stat.Label</span>
								</div>
							}
						</div>

						@if (ClaimedPowers.Count > 0)
						{
							<div class="run-powers">
								@foreach (var claimed in ClaimedPowers)
								{
									<div class="run-power">
										<Image class="run-power-icon" Texture="@claimed.Power.Image" />
										@if (claimed.Count > 1)
										{
											<span class="run-power-count">x@(claimed.Count)</span>
										}
									</div>
								}
							</div>
						}
					</div>
				}

				<div class="ladder-result">
					<div class="ladder-result-rank">@LadderResultText</div>
					@if (BestRunText is { } bestRun)
					{
						<div class="ladder-result-best">@bestRun</div>
					}
				</div>

				<div class="game-over-restart">Back to the lobby in @TimerText...</div>
			</div>
		</div>
	}
	else
	{
		<div class="timer">
			@TimerText
		</div>

		<div class="enemy-count hidden" @ref="EnemyCountPanel">
			@EnemyCountText
		</div>

		<div class="phase-text" @ref="PhaseTextPanel">
			@PhaseText
		</div>
	}

	@if (IsPauseMenuOpen && LocalPlayer != null)
	{
		<div class="pause-overlay">
			<div class="pause-card">
				<div class="pause-title">PAUSED</div>
				<div class="pause-subtitle">@PauseSubtitle</div>

				<div class="pause-section">
					<div class="run-stats-title">YOUR BUILD</div>

					<div class="pause-health">
						<div class="pause-health-header">
							<span class="pause-health-label">HEALTH</span>
							<span class="pause-health-value">@MathF.Ceiling(LocalPlayer.Hp) / @MathF.Ceiling(LocalPlayer.MaxHp)</span>
						</div>
						<div class="pause-health-bar">
							<div class="pause-health-fill" style="width: @LocalHealthWidth%"></div>
						</div>
					</div>

					<div class="pause-chips">
						@foreach (var stat in BuildStats)
						{
							<div class="pause-chip">
								<span class="pause-chip-value">@stat.Value</span>
								<span class="pause-chip-label">@stat.Label</span>
							</div>
						}
					</div>

					@if (ClaimedPowers.Count > 0)
					{
						<div class="run-powers">
							@foreach (var claimed in ClaimedPowers)
							{
								<div class="run-power">
									<Image class="run-power-icon" Texture="@claimed.Power.Image" />
									@if (claimed.Count > 1)
									{
										<span class="run-power-count">x@(claimed.Count)</span>
									}
								</div>
							}
						</div>
					}
				</div>

				<div class="pause-section">
					<div class="run-stats-title">THIS RUN</div>
					<div class="pause-chips">
						@foreach (var stat in RunStats.Take(3))
						{
							<div class="pause-chip">
								<span class="pause-chip-value">@stat.Value</span>
								<span class="pause-chip-label">@stat.Label</span>
							</div>
						}
					</div>
				</div>

				<div class="pause-buttons">
					<div class="pause-button" @onclick=@(() => SetPauseMenu(false))>RESUME</div>
					<div class="pause-button quit" @onclick=@QuitGame>QUIT</div>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	[Property] public GameState GameState { get; set; }
	[Property] public PlayerState PlayerState { get; set; }
	[Property] public DeathRewards DeathRewardsPanel { get; set; }

	public Panel EnemyCountPanel { get; set; }
	public Panel PhaseTextPanel { get; set; }
	public Panel PlayerCountPanel { get; set; }

	private GameStateType? _lastState;
	private RealTimeSince _timeSinceRoundEnded;
	private bool _lastRoundWon;
	private bool _isFadingOutPact = false;
	private bool _pactCompleted = false;

	private const int LadderSize = 100;
	private RunLeaderboard.LadderPage? _ladder;
	private bool _ladderLoading;
	private bool _ladderFailed;
	private int _ladderVersion;

	private PlayerState LocalPlayer =>
		PlayerState ?? Scene?.GetAllComponents<PlayerState>().FirstOrDefault(p => !p.IsProxy);

	private PlayerBehaviour LocalPlayerBehaviour =>
		Scene?.GetAllComponents<PlayerBehaviour>().FirstOrDefault(p => !p.IsProxy);

	private bool IsLocalPlayerDown => LocalPlayerBehaviour?.isDead ?? false;

	private bool IsLocalPlayerOut => LocalPlayerBehaviour?.isPermanentlyDead ?? false;

	private bool MustDevilPact => LocalPlayerBehaviour?.mustDevilPact ?? false;

	private int LivesLeft => LocalPlayer?.Lives ?? 0;

	private bool CanAffordPact => LivesLeft > 1;

	private string GhostSubtitle =>
		IsLocalPlayerOut
			? "You ran out of lives. This run is over for you."
			: "Your team has to clear the round to bring you back.";

	private int BonusCount
	{
		get
		{
			var player = LocalPlayer;
			return Math.Max(1, player?.XpMultiplier ?? 1);
		}
	}

	private bool ShowRoundWonBanner =>
		_lastRoundWon && GameState?.State == GameStateType.WaitingForNextRound && _timeSinceRoundEnded < 2.0f;

	private List<(string Label, string Value)> RunStats
	{
		get
		{
			var player = LocalPlayer;
			int powers = player.ClaimedBoosts.Count;

			return new List<(string Label, string Value)>
			{
				("KILLS", $"{player.Kills}"),
				("DAMAGE", FormatDamage(player.DamageDealt)),
				(player.Deaths == 1 ? "DEATH" : "DEATHS", $"{player.Deaths}"),
				(player.PactsMade == 1 ? "DEVIL PACT" : "DEVIL PACTS", $"{player.PactsMade}"),
				(player.LevelsGained == 1 ? "LEVEL UP" : "LEVEL UPS", $"{player.LevelsGained}"),
				(powers == 1 ? "POWER CLAIMED" : "POWERS CLAIMED", $"{powers}"),
			};
		}
	}

	private List<(Power Power, int Count)> ClaimedPowers
	{
		get
		{
			var powers = ResourceLibrary.GetAll<Power>().Where(p => p != null && p.Image != null).ToList();

			return LocalPlayer.ClaimedBoosts
				.GroupBy(boost => boost)
				.Select(group => (Power: powers.FirstOrDefault(p => p.BoostType == group.Key), Count: group.Count()))
				.Where(claimed => claimed.Power != null)
				.OrderByDescending(claimed => claimed.Count)
				.ToList();
		}
	}

	private static string FormatDamage(float damage) =>
		damage >= 10000f ? $"{damage / 1000f:0.#}K" : $"{MathF.Round(damage)}";

	private string RunTimeText => RunLeaderboard.FormatTime((int)MathF.Ceiling(GameState?.RunTime ?? 0f));

	private string LadderSubtitle =>
		_ladder is { } ladder && ladder.TotalPlayers > 0
			? $"TOP {LadderSize} OF {ladder.TotalPlayers} PLAYERS"
			: $"TOP {LadderSize}";

	private string LadderEmptyText =>
		_ladderLoading ? "Loading..."
		: _ladderFailed ? "Ladder unavailable right now."
		: "No runs yet. Be the first!";

	// Your own row, pinned under the list when you are not in the top
	private RunLeaderboard.Row? MyRowOutsideTop =>
		_ladder is { } ladder && ladder.Me is { } me && !ladder.Top.Any(row => row.IsMe) ? me : null;

	private string LadderResultText
	{
		get
		{
			if (_ladderFailed)
				return "LADDER UNAVAILABLE";

			if (_ladder is not { } ladder)
				return "SUBMITTING YOUR RUN...";

			if (ladder.Me is not { } me)
				return "RUN SUBMITTED";

			// The title font has no proper '#' glyph
			return $"GLOBAL RANK {me.Rank} / {Math.Max(ladder.TotalPlayers, me.Rank)}";
		}
	}

	// The ladder keeps your best run, say so when this one was not it
	private string BestRunText
	{
		get
		{
			if (_ladder?.Me is not { } me || GameState is null)
				return null;

			bool isThisRun = me.Rounds == GameState.CurrentRound && me.Seconds == (int)MathF.Ceiling(GameState.RunTime);

			return isThisRun ? "NEW PERSONAL BEST" : $"Your best: round {me.Rounds} in {RunLeaderboard.FormatTime(me.Seconds)}";
		}
	}

	// mustDevilPact is only set on players who went down this round
	private bool IsRoundEndBad => MustDevilPact;

	private string RoundEndText =>
		MustDevilPact ? "YOU FELL"
		: "ROUND WON";

	private bool AreAllPlayersReady()
	{
		var players = Scene?.GetAllComponents<PlayerBehaviour>().ToList();
		if (players == null || players.Count == 0)
			return false;

		int readyCount = 0;
		int total = 0;

		foreach (var p in players)
		{
			if (p == null || !p.IsValid())
				continue;

			if (p.isPermanentlyDead)
				continue;

			total++;
			if (p.State != null && p.State.RewardTaken)
				readyCount++;
		}

		return total > 0 && readyCount == total;
	}

	private bool ShowWaitingForPlayersBanner
	{
		get
		{
			if (GameState?.State != GameStateType.WaitingForNextRound)
				return false;

			if (ShowRoundWonBanner)
				return false;

			var player = LocalPlayer;
			bool localRewardTaken = player != null && player.RewardTaken;

			return localRewardTaken && !AreAllPlayersReady();
		}
	}

	private string CurrentRoundText =>
		GameState is null ? "1" : $"{Math.Max(1, GameState.CurrentRound)}";

	private string TimerText =>
		GameState is null
			? "0"
			: $"{MathF.Ceiling(GameState.PhaseTimer)}";

	private int RemainingEnemies => GameState?.EnemyCount ?? 0;

	private string EnemyCountText => $"{RemainingEnemies} enemies remaining";

	private string PhaseText =>
		GameState is null
			? ""
			: GameState.State switch
			{
				GameStateType.WaitingForPlayers => "Head to the start zone or wait for your team...",
				GameStateType.Starting => "All players are ready, the game is starting!",
				GameStateType.Playing => "",
				GameStateType.WaitingForNextRound => "Next round starting...",
				GameStateType.GameOver => "Game Over",
				_ => ""
			};

	private string PlayerCountText =>
		GameState is null
			? "0/4"
			: $"{GameState.PlayerCount}/4";

	private string ReadyCountText =>
		GameState is null
			? "0/0"
			: $"{GameState.PlayerReadyCount}/{GameState.PlayerCount}";

	private void OnLightChosen()
	{
		Log.Info("[DevilPact] Light side chosen: One More Round");
		var player = LocalPlayer;
		player?.Host_TakeReward();

		_pactCompleted = true;
	}

	private async void OnDarkChosen()
	{
		if (_isFadingOutPact || _pactCompleted)
			return;

		bool forced = MustDevilPact;

		if (!forced && !CanAffordPact)
			return;

		Log.Info($"[DevilPact] Dark side chosen: Devil Pact (Forced: {forced}, Gain: {BonusCount} Bonuses)");

		var player = LocalPlayer;

		if (!forced)
			player?.Host_LoseLife();

		player?.AddPactMade();

		_isFadingOutPact = true;
		StateHasChanged();

		await Task.DelayRealtimeSeconds(0.35f);

		_pactCompleted = true;
		_isFadingOutPact = false;
		StateHasChanged();

		var rewards = DeathRewardsPanel ?? Scene?.GetAllComponents<DeathRewards>().FirstOrDefault();
		rewards?.Show();
	}

	protected override void OnStart()
	{
		base.OnStart();

		IsPauseMenuOpen = false;
	}

	protected override void OnDestroy()
	{
		SetPauseMenu(false);

		base.OnDestroy();
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();

		if (GameState is null)
			return;

		UpdatePauseMenu();

		if (GameState.State != _lastState)
		{
			var previousState = _lastState;

			_lastState = GameState.State;
			_isFadingOutPact = false;
			_pactCompleted = false;

			// Only players who saw the run end submit it, not someone joining on the game over screen
			bool wasInRun = previousState is GameStateType.Playing or GameStateType.WaitingForNextRound;

			if (GameState.State == GameStateType.GameOver && wasInRun)
				_ = SubmitRunAndRefreshLadder();
			else if (GameState.State == GameStateType.WaitingForPlayers)
				_ = RefreshLadder();
			else if (GameState.State == GameStateType.Playing && previousState is GameStateType.Starting or GameStateType.WaitingForNextRound)
				RunAchievements.OnRoundStarted(GameState.CurrentRound);
		}
	}

	private async Task SubmitRunAndRefreshLadder()
	{
		_ladder = null;
		_ladderVersion++;

		try
		{
			RunLeaderboard.Submit(GameState.CurrentRound, GameState.RunTime);
			await RunLeaderboard.FlushAsync();
		}
		catch (Exception e)
		{
			Log.Warning($"[Ladder] Could not submit the run: {e.Message}");
		}

		await RefreshLadder();
	}

	private async Task RefreshLadder()
	{
		if (_ladderLoading)
			return;

		_ladderLoading = true;
		_ladderFailed = false;
		_ladderVersion++;

		try
		{
			_ladder = await RunLeaderboard.FetchAsync(LadderSize);
		}
		catch (Exception e)
		{
			_ladderFailed = true;
			Log.Warning($"[Ladder] Could not load the ladder: {e.Message}");
		}

		_ladderLoading = false;
		_ladderVersion++;
	}

	public void Show()
	{
		Panel.RemoveClass("hidden");
	}

	public void Hide()
	{
		Panel.AddClass("hidden");
	}

	public void OnRoundEnded(bool roundLost)
	{
		_lastRoundWon = !roundLost;
		_timeSinceRoundEnded = 0;

		if (_lastRoundWon)
			RunAchievements.OnRoundWon(LocalPlayerBehaviour);
	}

	public void ShowEnemyCount()
	{
		EnemyCountPanel?.RemoveClass("hidden");

		PhaseTextPanel?.AddClass("hidden");
		PlayerCountPanel?.AddClass("hidden");
	}

	public void HideEnemyCount()
	{
		EnemyCountPanel?.AddClass("hidden");

		PhaseTextPanel?.RemoveClass("hidden");
		PlayerCountPanel?.RemoveClass("hidden");
	}

	public static bool IsPauseMenuOpen { get; private set; }

	private bool _pausedWorld;

	private bool IsInRun =>
		GameState?.State is GameStateType.Starting or GameStateType.Playing or GameStateType.WaitingForNextRound;

	private static bool IsAlone => Connection.All.Count <= 1;

	private string PauseSubtitle =>
		$"ROUND {CurrentRoundText} · " + (_pausedWorld ? "THE GAME IS PAUSED" : "THE GAME KEEPS RUNNING FOR YOUR TEAM");

	private List<(string Label, string Value)> BuildStats
	{
		get
		{
			var player = LocalPlayer;

			return new List<(string Label, string Value)>
			{
				("DAMAGE", $"{player.BulletDamage:0.#}"),
				("SHOTS / SEC", $"{player.FireRate:0.#}"),
				("MOVE SPEED", $"{player.MoveSpeed:0}"),
				("BULLET SPEED", $"{player.BulletSpeed:0}"),
			};
		}
	}

	private string LocalHealthWidth
	{
		get
		{
			var player = LocalPlayer;
			float fraction = player == null || player.MaxHp <= 0f ? 0f : (player.Hp / player.MaxHp).Clamp(0f, 1f);

			return (fraction * 100f).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
		}
	}

	private void UpdatePauseMenu()
	{
		// Escape only opens our menu during a run, the lobby and game over keep the s&box menu
		if (Input.EscapePressed && IsInRun)
		{
			Input.EscapePressed = false;
			SetPauseMenu(!IsPauseMenuOpen);
		}

		if (IsPauseMenuOpen && !IsInRun)
			SetPauseMenu(false);

		// Someone joined while the world was paused
		if (_pausedWorld && !IsAlone)
		{
			Scene.TimeScale = 1f;
			_pausedWorld = false;
		}
	}

	private void SetPauseMenu(bool open)
	{
		IsPauseMenuOpen = open;

		bool pauseWorld = open && IsAlone && Networking.IsHost;

		if (pauseWorld != _pausedWorld && Scene is not null)
		{
			Scene.TimeScale = pauseWorld ? 0f : 1f;
			_pausedWorld = pauseWorld;
		}
	}

	private void QuitGame()
	{
		SetPauseMenu(false);
		Game.Close();
	}

	protected override int BuildHash()
	{
		var player = LocalPlayer;

		return HashCode.Combine(
			StateHash(),
			IsPauseMenuOpen,
			_pausedWorld,
			IsPauseMenuOpen && player != null ? HashCode.Combine(MathF.Ceiling(player.Hp), player.MaxHp, player.Lives) : 0
		);
	}

	private int StateHash()
	{
		if (GameState is null)
			return 0;

		if (GameState.State == GameStateType.WaitingForPlayers)
		{
			return HashCode.Combine(
				GameState.State,
				GameState.PlayerCount,
				GameState.PlayerReadyCount,
				_ladderVersion
			);
		}

		if (GameState.State == GameStateType.WaitingForNextRound)
		{
			var player = LocalPlayer;
			return HashCode.Combine(
				HashCode.Combine(
					GameState.State,
					ShowRoundWonBanner,
					ShowWaitingForPlayersBanner,
					AreAllPlayersReady(),
					(int)MathF.Ceiling(GameState.PhaseTimer),
					_isFadingOutPact,
					_pactCompleted,
					player?.RewardTaken ?? false
				),
				HashCode.Combine(MustDevilPact, IsLocalPlayerOut, LivesLeft, BonusCount)
			);
		}

		return HashCode.Combine(
			HashCode.Combine(
				GameState.State,
				GameState.CurrentRound,
				(int)MathF.Ceiling(GameState.PhaseTimer),
				GameState.PlayerCount,
				GameState.PlayerReadyCount,
				RemainingEnemies,
				IsLocalPlayerDown,
				IsLocalPlayerOut
			),
			_ladderVersion
		);
	}
}
